    stm=${tm%% *}; stm=${stm//[()]/}; tm=${tm##* }
    cs=$(wt --menu "Guidata 5/5: lato del crop" 0 0 0 256 "crop 256 (tarato)" 128 "crop 128 (parametri del 256)" 64 "crop 64 (parametri del 256)") || return
    conf="--kalman-crop --max-crops 1 --crop-size $cs --track-model $PWD/$tm/best.pt --preset $PWD/experiments/tracking/taratura_kalman_crop/results/kalman_crop_f2_val.json"
    nome=${f}__kalman-crop_SCAN-${sm}_TRACK-${stm}_crop$cs
  elif [[ $kf == kalman ]]; then
    conf="--kalman --preset $PWD/experiments/tracking/taratura_kalman/results/kalman_f2_${SRC_STUDIO}_val.json"
    nome=${f}__kalman_${sm}_senza-crop
  else
    conf=$(scegli_conf "$m") || return
    nome=${f}__solo-detector_${sm}_conf$conf; conf="--conf $conf"
  fi
  PAR_OVR=()
  if [[ $kf != no ]]; then x=${conf#*--preset }; prima_di_avviare "${x%% *}" || return; fi
  src=$SRC_DIR
  lancia predict "$PY -m tools.predict_video $PWD/$m/best.pt $(printf %q "$src") $conf$(par_args) --imgsz 640${SRC_FONTE:+ --fonte $SRC_FONTE} --out $(printf %q "$PWD/predict/risultati/$nome")"
}
predict_manuale() {  # modalita' pro: un modulo con tutti i campi e i valori del deploy; si cambia un campo alla volta, poi avvia
  local args=() m=$PESI_SCAN tm=$PESI_TRACK src=$PWD/data/tracking/val fonte=tutte imgsz=640 mode=fit kf=kalman-crop
  local conf=0.25 cs=256 mc=1 rs="" ma=no ps=experiments/tracking/taratura_kalman_crop/results/kalman_crop_f2_val.json
  local vedi=mostra extra="" campo voci x out cmd
  PAR_OVR=()
  while true; do
    voci=(avvia "lancia il predict con i valori qui sotto" "" "modello e sorgente"
      modello "$(basename "$m")$([[ $kf == kalman-crop ]] && echo "  (SCAN)")"
      sorgente "${src#$PWD/}" fonte "$fonte  (solo sequenze di data/tracking)"
      ingresso "$imgsz, $mode" "" "tracker e parametri" tracker "$kf")
    if [[ $kf == no ]]; then voci+=(soglia "$conf")
    else voci+=(preset "${ps##*/}" parametri "$([[ ${#PAR_OVR[@]} -gt 0 ]] && echo "${#PAR_OVR[@]} cambiati: ${PAR_OVR[*]}" || echo "tutti dal preset")  (vedi e cambia)"); fi
    [[ $kf == kalman-crop ]] && voci+=("modello-crop" "$(basename "$tm")  (TRACK)" crop "lato $cs, max $mc crop"
      rescan "${rs:-dal preset (o 30)}" maschera "$ma  (in SCAN solo box sopra la F1 per classe del modello dello SCAN; tasto m)")
    voci+=("" "uscita" finestra "$vedi" altri "${extra:-nessuno}  (argomenti in piu' di tools/predict_video.py)")
    campo=$(wt --menu "Predict, modalita' pro: Invio su un campo per cambiarlo, poi avvia. Valori di partenza: il tracker del deploy." 0 0 0 "${voci[@]}") || return
    case $campo in
      avvia) break ;;
      modello|modello-crop)
        mapfile -t args < <(lista_pesi "$([[ $campo == modello ]] && echo "$PESI_SCAN" || echo "$PESI_TRACK")" "$([[ $campo == modello ]] && echo "P- per lo SCAN" || echo "S- per il TRACK")")
        x=$(wt --menu "$campo (mAP50-95 del training). Scrivi la sigla per filtrare." 0 0 0 "${args[@]}") || continue
        [[ $campo == modello ]] && m=${x##* } || tm=${x##* } ;;
      sorgente)
        x=$(wt --inputbox "Video, cartella di video, sequenza di data/tracking o cartella di sequenze (fps da seq.json):" 0 0 "$src") || continue
        [[ -e $x ]] && src=$x || wt --msgbox "$x non esiste." ;;
      fonte) fonte=$(wt --menu "Quali sequenze:" 0 0 0 tutte "tutte" svanstrom "solo Svanstrom" anti_uav "solo Anti-UAV") || fonte=tutte ;;
      ingresso)
        x=$(wt --menu "Ingresso del modello (lato lungo; il letterbox arrotonda l'altro a 32). Allenato a 640." 0 0 0 \
            640 "lato lungo 640, quello degli esperimenti (16:9 entra 640x384)" 480,864 "480p: 864x480" \
            736,1280 "720p: 1280x736" 1088,1920 "1080p: 1920x1088" 320 "lato lungo 320: veloce, i droni piccoli spariscono" \
            altro "a mano: lato lungo, o ALTEZZA,LARGHEZZA") || continue
        [[ $x == altro ]] && { x=$(wt --inputbox "Lato lungo, o ALTEZZA,LARGHEZZA, multipli di 32:" 0 0 "$imgsz") || continue; }
        [[ $x =~ ^[0-9]+(,[0-9]+)?$ ]] && ! (( ${x%,*} % 32 || ${x#*,} % 32 )) || { wt --msgbox "imgsz: multipli di 32, un numero o ALTEZZA,LARGHEZZA."; continue; }
        imgsz=$x
        mode=$(wt --menu "Come il fotogramma entra nel modello:" 0 0 0 fit "si scala per starci dentro (letterbox)" \
            crop "ritaglio dal centro a risoluzione nativa, senza scalare") || mode=fit ;;
      tracker)
        x=$(wt --menu "Tracker sulle detection:" 0 0 0 kalman-crop "Kalman con crop: fotogramma intero solo in SCAN, poi crop sul track" \
            kalman "Kalman: classe a voto, box filtrate, detection deboli se confermano un track" no "nessuno, le box del modello") || continue
        [[ $x == "$kf" ]] && continue
        kf=$x   # preset coerente con il tracker nuovo; si cambia dal campo preset
        case $kf in kalman-crop) ps=experiments/tracking/taratura_kalman_crop/results/kalman_crop_f2_val.json ;;
                    kalman) ps=experiments/tracking/taratura_kalman/results/kalman_f2_tutte_val.json ;;
                    no) [[ -f $m/soglie_f1_val.json ]] && conf=$("$PY" -c 'import json,sys; print(json.load(open(sys.argv[1]))["tutte"][0])' "$m/soglie_f1_val.json") ;; esac ;;
      soglia) x=$(scegli_conf "$m") && conf=$x ;;
      parametri) edita_parametri "$ps" ;;
      preset)
        local pre=(default "default del codice (src/tracking.py, src/crop_tracker.py)") K=experiments/tracking/taratura_kalman/results C=experiments/tracking/taratura_kalman_crop/results dir nota ob st f
        [[ $kf == kalman-crop && -f $C/kalman_crop_f2_val.json ]] && pre+=("$C/kalman_crop_f2_val.json" "Kalman con crop tarato insieme, F2 droni + vincolo, due fonti")
        for f in $C/kalman_crop_f1_val*.json; do
          [[ $kf == kalman-crop && -f $f ]] && pre+=("$f" "Kalman con crop tarato insieme, F1 droni + vincolo, due fonti$([[ $f == *prova* ]] && echo " (${f##*_}: ricerca in corso)")")
        done
        for ob in f2 f1; do
          for st in tutte svanstrom anti_uav; do
            f=$K/kalman_${ob}_${st}_val.json
            [[ -f $f ]] && pre+=("$f" "Kalman tarato $([[ $ob == f2 ]] && echo "F2 droni + vincolo aerei" || echo "F1 tutte le classi"), studio ${st/tutte/due fonti}")
          done
        done
        x=$(wt --menu "Parametri del tracker. Scrivi per filtrare (svan, anti, f2, f1, crop)." 0 0 0 "${pre[@]}") && ps=$x ;;
      crop)
        x=$(wt --menu "Lato del crop del TRACK (i parametri tarati sono del 256):" 0 0 0 256 "tarato" 128 "" 64 "" 512 "") && cs=$x
        x=$(wt --inputbox "Numero massimo di crop per fotogramma (S- sta nel budget solo con 1):" 0 0 "$mc") && [[ $x =~ ^[1-9][0-9]*$ ]] && mc=$x ;;
      maschera) [[ $ma == no ]] && ma=si || ma=no
                [[ $ma == si ]] && ! grep -qs per_classe "$m/soglie_f1_val.json" && { ma=no
                  wt --msgbox "$(basename "$m") non ha le soglie per classe. Calcolarle (pochi minuti sulla GPU): python tools/curva_fbeta.py $m/best.pt --soglie"; } ;;
      rescan) x=$(wt --inputbox "Re-scan del fotogramma intero ogni N fotogrammi (0 = mai, resta quello dopo un mancato; vuoto = il preset o 30):" 0 0 "$rs") \
                && [[ -z $x || $x =~ ^[0-9]+$ ]] && rs=$x ;;
      finestra) vedi=$(wt --menu "Durante il predict:" 0 0 0 mostra "finestra dal vivo e video salvato" salva "niente finestra, salva solo i video (piu' veloce)") || vedi=mostra ;;
      altri) x=$(wt --inputbox "Argomenti in piu' (es. --min-hits 2, --hi 0.3, --max-age 20, --allarme 0; vincono sul preset. Elenco: python -m tools.predict_video --help):" 0 0 "$extra") && extra=$x ;;
    esac
  done
  cmd="$PWD/$m/best.pt $(printf %q "$src") --imgsz $imgsz --mode $mode"
  case $kf in
    no) cmd+=" --conf $conf" ;;
    kalman) cmd+=" --kalman" ;;
    kalman-crop) cmd+=" --kalman-crop --crop-size $cs --max-crops $mc --track-model $PWD/$tm/best.pt${rs:+ --rescan $rs}$([[ $ma == si ]] && echo " --maschera-scan")"
                 ;;
  esac
  [[ $kf != no && $ps != default ]] && cmd+=" --preset $PWD/$ps"
  [[ $kf != no ]] && cmd+="$(par_args)"
  [[ $fonte != tutte ]] && cmd+=" --fonte $fonte"
  [[ $vedi == salva ]] && cmd+=" --no-show"
  [[ -n $extra ]] && cmd+=" $extra"
  out=$PWD/predict/risultati/manuale_$(basename "$m")_${imgsz/,/x}_${mode}_$kf$([[ $kf == kalman-crop ]] && echo "_crop$cs")_$(date +%H%M%S)
  lancia predict "$PY -m tools.predict_video $cmd --out $(printf %q "$out")"
}
pulizia_hydra() {  # cartelle di runs/hydra dei run finiti (non la cwd di un run.py vivo)
  local d p att=() via=()
  for p in $(pgrep -f '^[^ ]*python[^ ]* run[.]py' || true); do att+=("$(readlink -f /proc/"$p"/cwd)"); done
  for d in runs/hydra/outputs/*/ runs/hydra/multirun/*/; do
    [[ -d $d ]] || continue; d=$(readlink -f "$d")
    [[ " ${att[*]} " == *" $d"* ]] || via+=("$d")
  done
  ((${#via[@]})) || { wt --msgbox "Niente da cancellare in runs/hydra/."; return; }
  wt --yesno "Cancello ${#via[@]} cartelle di runs/hydra/ (config e run.log dei run finiti)?\n\nLe misure stanno in results/ e artifacts/: non si toccano." || return
  rm -rf "${via[@]}"; wt --msgbox "Cancellate ${#via[@]} cartelle."
}
