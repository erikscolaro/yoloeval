#!/usr/bin/env bash
# Configuratore e launcher degli esperimenti, menu in bash puro. Costruisce solo la riga di comando di run.py o degli
# script: opzioni da conf/<gruppo>/, help da docs/config/, nessuno YAML modificato. Ogni run va in runs/ con il comando.
#   ./lab
set -uo pipefail
cd "$(dirname "$(readlink -f "$0")")"
PY=.venv/bin/python
RUNS=runs
mkdir -p "$RUNS"
# Step in ordine di esecuzione, con il grafo delle dipendenze (colonna 1: train -> export -> benchmark;
# colonna 2: il ramo delle strategie pit; colonna 3: board e LUT) e chi serve prima di ognuno.
STEPS_ALL=(provision lut train select search finetune export benchmark)
GRAPH_ALL=('    ●──┐' '    ●  │' '●   │  │' '├─●─┤  │' '│ ●─┘  │' '│ ●    │' '●─┘    │' '●──────┘')
DEPS_ALL=('' 'provision' '' 'train, lut' 'select, lut' 'search' 'train o finetune' 'export, provision')
GRAPH=()          # colonna del grafo nelle checklist, se impostata
STEPS=()          # step scelti, nell'ordine di STEPS_ALL
OV=()             # override Hydra, chiave=valore
T="yoloeval lab"
trap 'rm -f /tmp/lab_err.$$' EXIT

# Widget in bash puro, con gli argomenti di whiptail (--menu, --checklist, --inputbox, --msgbox, --yesno).
# Tasti: su/giu' muovono, Invio e freccia destra entrano o scelgono, freccia sinistra, Esc e Backspace tornano indietro,
# spazio spunta nelle checklist. Disegnano su /dev/tty; la scelta esce su stdout; indietro = exit status 1.
key() {  # legge un tasto: up down right left enter back space o il carattere
  local k r
  IFS= read -rsn1 k </dev/tty
  case $k in
    $'\e') IFS= read -rsn2 -t 0.02 r </dev/tty
           case $r in '[A') echo up ;; '[B') echo down ;; '[C') echo right ;; '[D') echo left ;;
                      '[5') read -rsn1 -t 0.02 </dev/tty; echo pgup ;; '[6') read -rsn1 -t 0.02 </dev/tty; echo pgdn ;;
                      *) echo back ;; esac ;;
    '') echo enter ;; ' ') echo space ;; $'\x7f' | $'\b') echo back ;; *) echo "$k" ;;
  esac
}

wt() {
  local mode=$1 text=$2 tags=() descs=() on=() n i cur=0 top=0 rows k step=2 sel out
  shift 2
  case $mode in
    --menu | --checklist)
      shift 3; [[ $mode == --checklist ]] && step=3
      while (($#)); do tags+=("$1"); descs+=("$2"); [[ $step == 3 ]] && on+=("$3"); shift $step; done
      n=${#tags[@]}
      while :; do
        rows=$(($(tput lines) - $(printf '%b\n' "$text" | wc -l) - 6)); ((rows < 3)) && rows=3
        ((cur < top)) && top=$cur; ((cur >= top + rows)) && top=$((cur - rows + 1))
        { tput clear; printf '\e[1m%s\e[0m\n\n%b\n\n' "$T" "$text"
          for ((i = top; i < n && i < top + rows; i++)); do
            sel="  "; ((i == cur)) && sel="> "
            [[ $step == 3 ]] && { [[ ${on[i]} == ON ]] && sel+="[x] " || sel+="[ ] "; }
            ((i == cur)) && printf '\e[7m'
            printf '%s%s  %-12s %s\e[0m\n' "$sel" "${GRAPH[i]:-}" "${tags[i]}" "${descs[i]:0:$(($(tput cols) - 30))}"
          done
          printf '\n\e[2m su/giu muovi   Invio/destra %s   sinistra/Esc indietro%s\e[0m' \
            "$([[ $step == 3 ]] && echo conferma || echo entra)" "$([[ $step == 3 ]] && echo '   spazio spunta')"
        } >/dev/tty
        k=$(key)
        case $k in
          up) ((cur > 0)) && ((cur--)) ;; down) ((cur < n - 1)) && ((cur++)) ;;
          pgup) cur=$((cur > rows ? cur - rows : 0)) ;; pgdn) cur=$((cur + rows < n ? cur + rows : n - 1)) ;;
          space) [[ $step == 3 ]] && { [[ ${on[cur]} == ON ]] && on[cur]=OFF || on[cur]=ON; } ;;
          left | back) return 1 ;;
          enter | right)
            if [[ $step == 3 ]]; then
              out=""; for ((i = 0; i < n; i++)); do [[ ${on[i]} == ON ]] && out+="\"${tags[i]}\" "; done
              echo "$out"
            else echo "${tags[cur]}"; fi
            return 0 ;;
        esac
      done ;;
    --inputbox)
      { tput clear; printf '\e[1m%s\e[0m\n\n%b\n\n\e[2m Invio conferma   Ctrl-D annulla\e[0m\n' "$T" "$text"; } >/dev/tty
      IFS= read -re -i "$3" -p "> " out </dev/tty 2>/dev/tty || return 1
      echo "$out" ;;
    --msgbox)
      { tput clear; printf '\e[1m%s\e[0m\n\n%b\n\n\e[2m un tasto per continuare\e[0m' "$T" "$text"; } >/dev/tty
      key >/dev/null ;;
    --yesno)
      { tput clear; printf '\e[1m%s\e[0m\n\n%b\n\n\e[2m Invio/destra si   sinistra/Esc no\e[0m' "$T" "$text"; } >/dev/tty
      while :; do case $(key) in enter | right) return 0 ;; left | back) return 1 ;; esac; done ;;
  esac
}
size() { H=0; W=0; L=0; }  # misure di whiptail: i widget sopra si adattano al terminale

set_ov() {  # set_ov chiave valore: sostituisce l'override con la stessa chiave
  local k=$1 v=$2 i out=()
  for i in "${OV[@]}"; do [[ ${i%%=*} == "$k" ]] || out+=("$i"); done
  [[ -n $v ]] && out+=("$k=$v")
  OV=("${out[@]}")
}

stage_help() {  # riga di docs/config/stage.yaml: "#   train     -> ..."
  [[ $1 == lut ]] && { echo "scripts/build_lut.sh: LUT e fit dello stimatore di latenza (~40 h sul Pi, riprende)"; return; }
  grep -E "^  #   $1 +->" docs/config/stage.yaml | sed -E 's/^  #   [a-z]+ +-> //' | head -1
}

doc_help() {  # doc_help gruppo chiave: la riga della chiave e i commenti sotto, da docs/config/<gruppo>.yaml
  local f=docs/config/$1.yaml k=${2##*.}
  [[ -f $f ]] || f=docs/config/config.yaml
  # shortcut: cerca solo l'ultimo pezzo della chiave; con due chiavi omonime nel file prende la prima
  awk -v k="$k" '
    f && /^[[:space:]]*#/ { sub(/^[[:space:]]*#[[:space:]]?/, ""); print; next }
    f { exit }
    $0 ~ "^[[:space:]]*" k ":" { f = 1 }' "$f"
}

menu_steps() {
  local s args=() on i
  for i in "${!STEPS_ALL[@]}"; do
    s=${STEPS_ALL[i]}
    on=OFF; [[ " ${STEPS[*]} " == *" $s "* ]] && on=ON
    args+=("$s" "$([[ -n ${DEPS_ALL[i]} ]] && echo "[dopo ${DEPS_ALL[i]}] ")$(stage_help "$s")" "$on")
  done
  size
  local GRAPH=("${GRAPH_ALL[@]}")
  s=$(wt --checklist "Step da eseguire, dall'alto in basso (spazio per scegliere). La catena si ferma al primo errore;\nogni step riusa dalla cache quello che ha fatto il precedente. La colonna centrale (select, search, finetune)\nserve solo alle strategie pit; con strategy=baseline si va da train a export. A destra board e LUT." $H $W $L "${args[@]}") || return
  STEPS=()
  for x in "${STEPS_ALL[@]}"; do [[ $s == *"\"$x\""* ]] && STEPS+=("$x"); done
}

# Varianti della griglia nel menu dei modelli (model=yolo26 + larghezza e profondita'), con la sigla della tesi
GRIGLIA=()
for w in 0.0625:F 0.09375:FP 0.125:P 0.1875:PN 0.25:N 0.375:NS 0.5:S 0.75:SM 1.0:M; do
  for d in D101:- D126: D170:+; do GRIGLIA+=("${w%%:*}:${d%%:*}" "${w##*:}${d##*:}  (larghezza ${w%%:*}, ${d%%:*})"); done
done

menu_gruppi() {
  local g f d args=() o
  while :; do
    args=()
    for d in conf/*/; do
      g=$(basename "$d"); [[ $g == stage ]] && continue
      o=$(printf '%s\n' "${OV[@]}" | sed -n "s/^$g=//p")
      args+=("$g" "${o:-(default)}")
    done
    size
    g=$(wt --menu "Gruppi di configurazione: un file per opzione in conf/<gruppo>/." $H $W $L "${args[@]}") || return
    args=("-" "(default di conf/config.yaml)")
    for f in conf/"$g"/*.yaml; do
      o=$(basename "$f" .yaml)
      args+=("$o" "$(grep -m1 -E '^#' "$f" | grep -v '@package' | sed 's/^# *//' | cut -c1-70)")
    done
    [[ $g == model ]] && args+=("${GRIGLIA[@]}")
    o=$(wt --menu "conf/$g/: scegli un'opzione." $H $W $L "${args[@]}") || continue
    [[ $o == - ]] && o=""
    set_ov model.width ""; set_ov model.depth ""
    if [[ $g == model && $o == *:* ]]; then   # variante della griglia: model=yolo26 con larghezza e profondita'
      set_ov model yolo26; set_ov model.width "${o%%:*}"; set_ov model.depth "${o##*:}"
    elif [[ $o =~ ^[0-9]+$ ]]; then set_ov "$g" "'$o'"
    else set_ov "$g" "$o"; fi
  done
}

flat() {  # flat STAGE: chiave<TAB>valore della config composta; se non si compone, l'errore di Hydra su stderr
  local y
  y=$("$PY" run.py "stage=$1" "${OV[@]}" --cfg job 2>&1) || { grep -v '^ \|^Traceback\|^$' <<<"$y" | tail -2 >&2; return 1; }
  "$PY" -c '
import sys, yaml
def w(n, p=""):
    if isinstance(n, dict) and n:
        for k, v in n.items():
            yield from w(v, f"{p}{k}.")
    else:
        yield p[:-1], n
for k, v in w(yaml.safe_load(sys.stdin)):
    print(f"{k}\t{"null" if v is None else v}")' <<<"$y"
}

menu_parametri() {  # prima lo step (ognuno compone la sua config), poi la sezione, poi il campo
  local st cfg sez k v args h err
  while :; do
    args=()
    for st in "${STEPS_ALL[@]}"; do
      [[ $st == lut ]] && continue
      args+=("$st" "$([[ " ${STEPS[*]} " == *" $st "* ]] && echo "scelto")")
    done
    st=$(wt --menu "Parametri di quale step? Ogni step compone la sua config; gli override valgono per tutti." 0 0 0 "${args[@]}") || return
    cfg=$(flat "$st" 2>/tmp/lab_err.$$) || { err=$(cat /tmp/lab_err.$$); wt --msgbox "La config di stage=$st non si compone:\n\n$err\n\nOverride: ${OV[*]}"; continue; }
    while :; do
      args=()
      while read -r sez; do args+=("$sez" ""); done < <(cut -f1 <<<"$cfg" | cut -d. -f1 | awk '!s[$0]++')
      sez=$(wt --menu "stage=$st: sezioni della config composta." 0 0 0 "${args[@]}") || break
      while :; do
        args=()
        while IFS=$'\t' read -r k v; do args+=("$k" "${v:0:60}"); done < <(grep -E "^$sez(\.|$(printf '\t'))" <<<"$cfg")
        k=$(wt --menu "stage=$st, $sez: scegli il campo da cambiare." 0 0 0 "${args[@]}") || break
        v=$(grep -P "^\Q$k\E\t" <<<"$cfg" | cut -f2-)
        h=$(doc_help "$sez" "$k" | head -15)
        v=$(wt --inputbox "$k\n\n${h:-(nessun help in docs/config/)}\n\nValore (vuoto = togli l'override):" 0 0 "$v") || continue
        set_ov "$k" "$v"
        cfg=$(flat "$st" 2>/tmp/lab_err.$$) || { wt --msgbox "Con $k=$v la config non si compone:\n\n$(cat /tmp/lab_err.$$)"; set_ov "$k" ""; cfg=$(flat "$st"); }
      done
    done
  done
}

comandi() {  # una riga per step
  local s
  for s in "${STEPS[@]}"; do
    if [[ $s == lut ]]; then echo "scripts/build_lut.sh"   # parametri propri (src/lut/pi.py), non gli override
    else printf '%s run.py stage=%s' "$PY" "$s"; ((${#OV[@]})) && printf ' %q' "${OV[@]}"; echo; fi
  done
}

lancia() {  # lancia NOME COMANDI: in background con nohup, log in runs/, poi lo segue
  local log="$RUNS/$(date +%Y-%m-%d_%H-%M-%S)_$1.log"
  { echo "# $(date -Is)"; sed 's/^/# CMD /' <<<"$2"; } >"$log"
  nohup bash -c "set -e; $(sed 's/$/;/' <<<"$2")" >>"$log" 2>&1 &
  echo "$!" >"$log.pid"
  segui "$log"
}

segui() {
  clear
  echo "== $1   (Ctrl-C torna al menu, il run continua)"
  trap 'true' INT
  tail -n 200 -f "$1" --pid "$(cat "$1.pid" 2>/dev/null || echo 1)" || true
  trap - INT
  read -rp "Invio per tornare al menu... " _
}

avvio() {
  [[ ${#STEPS[@]} -gt 0 ]] || { wt --msgbox "Nessuno step scelto." 8 40; return; }
  local c; c=$(comandi)
  size
  wt --yesno "Comandi:\n\n$c\n\nAvvio?" $H $W || return
  lancia "$(IFS=-; echo "${STEPS[*]}")" "$c"
}

strumenti() {
  local f args=() a
  for f in scripts/*.sh tools/*.py; do
    args+=("$f" "$(sed -n '2,6p' "$f" | grep -m1 -E '^#' | sed 's/^# *//' | cut -c1-70)")
  done
  size
  f=$(wt --menu "Script e strumenti (help: commento in testa al file)." $H $W $L "${args[@]}") || return
  a=$(wt --inputbox "$(sed -n '1,12p' "$f" | grep -E '^#' | sed 's/^# *//')\n\nArgomenti:" $H $W "") || return
  [[ $f == *.py ]] && f="$PY $f"
  lancia "$(basename "${f##* }" | cut -d. -f1)" "$f $a"
}

storico() {
  local args=() l a c
  for l in $(ls -t "$RUNS"/*.log 2>/dev/null | head -40); do
    args+=("$l" "$(grep -m1 '^# CMD' "$l" | cut -c7-70)")
  done
  [[ ${#args[@]} -gt 0 ]] || { wt --msgbox "Nessun run in $RUNS/." 8 40; return; }
  size
  l=$(wt --menu "Run, dal piu' recente." $H $W $L "${args[@]}") || return
  a=$(wt --menu "$l" 12 60 3 log "segui il log" rilancia "ripeti gli stessi comandi" ferma "termina il run") || return
  case $a in
    log) segui "$l" ;;
    rilancia) c=$(sed -n 's/^# CMD //p' "$l"); lancia "$(basename "$l" .log | cut -d_ -f3-)" "$c" ;;
    ferma) kill "$(cat "$l.pid")" 2>/dev/null && wt --msgbox "Fermato." 8 30 ;;
  esac
}

HELP='\e[1mCome si usa\e[0m
Si sceglie cosa fare (step), con quale configurazione (gruppi, parametri), poi si avvia. Il launcher scrive solo
la riga di comando di run.py: gli YAML in conf/ non cambiano mai, le modifiche sono override Hydra.

\e[1mSezioni\e[0m
  step        gli stadi della pipeline, in ordine di esecuzione, con il grafo delle dipendenze. Se ne sceglie
              uno, una parte o la catena intera; la catena si ferma al primo errore.
  gruppi      per ogni gruppo di conf/ (target, model, strategy, train, ...) quale file usare. target e\x27 il
              profilo di deploy: fissa dispositivo, risoluzione, backend, precisione, budget e LUT insieme.
  parametri   la config composta, sezione per sezione: si cambia un campo e si legge il suo help
              (da docs/config/). Valore vuoto = torna al default.
  avvio       mostra i comandi esatti e li lancia in background; il log scorre qui, Ctrl-C torna al menu
              e il run continua.
  strumenti   script di scripts/ e tools/ (LUT, figure, ...), con l\x27help del commento in testa al file.
  storico     i run in runs/: seguire il log, rilanciare gli stessi comandi, fermare un run.

\e[1mTasti\e[0m
  su/giu muovono, Invio o destra entrano o scelgono, sinistra, Esc o Backspace tornano indietro,
  spazio spunta gli step, Ctrl-D annulla la scrittura di un valore. Indietro dalla pagina principale esce.'

while :; do
  size
  s=$(wt --menu "Step: ${STEPS[*]:-nessuno}\nOverride: ${OV[*]:-nessuno}" $H $W $L \
      step "scegli gli step (catena completa o parte)" \
      gruppi "profilo, modello, strategia, ..." \
      parametri "cambia un campo, con il suo help" \
      avvio "anteprima dei comandi e avvio" \
      strumenti "script e figure fuori da run.py" \
      storico "run passati: log, rilancio, stop" \
      help "cosa fanno le sezioni e i tasti") || { clear; exit 0; }
  case $s in
    step) menu_steps ;; gruppi) menu_gruppi ;; parametri) menu_parametri ;;
    avvio) avvio ;; strumenti) strumenti ;; storico) storico ;; help) wt --msgbox "$HELP" ;;
  esac
done
